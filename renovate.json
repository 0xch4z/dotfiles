{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "America/New_York",
  "semanticCommits": "enabled",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "customDatasources": {
    "nvidia-linux": {
      "defaultRegistryUrlTemplate": "https://download.nvidia.com/XFree86/Linux-x86_64/latest.txt",
      "format": "plain"
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^modules/linux/nvidia\\.nix$/"],
      "matchStrings": [
        "# renovate: nvidia-production=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "nvidia-production",
      "datasourceTemplate": "custom.nvidia-linux",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "matchDepNames": ["nvidia-production"],
      "extractVersion": "^(?<version>\\d+\\.\\d+(?:\\.\\d+)?)",
      "automerge": false,
      "prBodyNotes": [
        "This updates only the notification marker. Update the mkDriver version and hashes from nixpkgs before merging."
      ]
    }
  ]
}
