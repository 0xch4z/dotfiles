+/* Calculate the cell width occupied by OSC 66 payload. */
+static u_int
+input_osc_66_width(const char *p)
+{
+	const char	*text, *errstr;
+	char		*copy, *metadata, *next, *value;
+	long long	 scale = 1, width = 0;
+	u_int		 result;
+
+	text = strchr(p, ';');
+	if (text == NULL || !utf8_isvalid(text + 1))
+		return (0);
+	copy = metadata = xstrndup(p, text - p);
+	while ((next = strsep(&metadata, ":")) != NULL) {
+		if ((value = strchr(next, '=')) == NULL)
+			continue;
+		*value++ = '\0';
+		if (strcmp(next, "s") == 0) {
+			scale = strtonum(value, 1, 7, &errstr);
+			if (errstr != NULL)
+				scale = 1;
+		} else if (strcmp(next, "w") == 0) {
+			width = strtonum(value, 0, 7, &errstr);
+			if (errstr != NULL)
+				width = 0;
+		}
+	}
+	free(copy);
+
+	if (width == 0)
+		result = utf8_cstrwidth(text + 1) * scale;
+	else
+		result = width * scale;
+	return (result);
+}
+
+/* Retain OSC 66. */
+static void
+input_osc_66(struct input_ctx *ictx, const char *p)
+{
+	struct screen_write_ctx	*sctx = &ictx->ctx;
+	struct window_pane	*wp = ictx->wp;
+	u_char			*sequence;
+	size_t			 size, end_size;
+	u_int			 width, cx;
+
+	if (wp == NULL)
+		return;
+	end_size = ictx->input_end == INPUT_END_ST ? 2 : 1;
+	size = 2 + ictx->input_len + end_size;
+	sequence = xmalloc(size);
+	sequence[0] = '\033';
+	sequence[1] = ']';
+	memcpy(sequence + 2, ictx->input_buf, ictx->input_len);
+	if (ictx->input_end == INPUT_END_ST) {
+		sequence[size - 2] = '\033';
+		sequence[size - 1] = '\\';
+	} else
+		sequence[size - 1] = '\007';
+
+	window_pane_osc66_store(wp, sctx->s->cx, sctx->s->cy, sequence, size);
+	screen_write_rawstring(sctx, sequence, size, 0);
+	free(sequence);
+
+	width = input_osc_66_width(p);
+	cx = sctx->s->cx;
+	if (width > screen_size_x(sctx->s) - cx)
+		cx = screen_size_x(sctx->s);
+	else
+		cx += width;
+	screen_write_cursormove(sctx, cx, -1, 0);
+}
+
