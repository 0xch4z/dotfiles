diff --git c/window.c w/window.c
index 562fcc7..fb76370 100644
--- c/window.c
+++ w/window.c
@@ -945,0 +946 @@ window_pane_create(struct window *w, u_int sx, u_int sy, u_int hlimit)
+	TAILQ_INIT(&wp->osc66_entries);
@@ -979,0 +981 @@ window_pane_destroy(struct window_pane *wp)
+	window_pane_osc66_clear(wp);
@@ -1018,0 +1021,37 @@ window_pane_destroy(struct window_pane *wp)
+void
+window_pane_osc66_store(struct window_pane *wp, u_int x, u_int y,
+    const void *data, size_t size)
+{
+	struct osc66_entry	*oe;
+
+	if (size > 8192)
+		return;
+	TAILQ_FOREACH(oe, &wp->osc66_entries, entry) {
+		if (oe->x == x && oe->y == y)
+			break;
+	}
+	if (oe == NULL) {
+		oe = xcalloc(1, sizeof *oe);
+		oe->x = x;
+		oe->y = y;
+		TAILQ_INSERT_TAIL(&wp->osc66_entries, oe, entry);
+	}
+
+	free(oe->data);
+	oe->data = xmalloc(size + 1);
+	memcpy(oe->data, data, size);
+	oe->data[size] = '\0';
+}
+
+void
+window_pane_osc66_clear(struct window_pane *wp)
+{
+	struct osc66_entry	*oe, *oe1;
+
+	TAILQ_FOREACH_SAFE(oe, &wp->osc66_entries, entry, oe1) {
+		TAILQ_REMOVE(&wp->osc66_entries, oe, entry);
+		free(oe->data);
+		free(oe);
+	}
+}
+
