@@ -945,0 +948,29 @@ screen_redraw_draw_pane(struct screen_redraw_ctx *ctx, struct window_pane *wp)
+
+	/*
+	 * OSC 66 text does not enter the grid, so replay it after the grid has
+	 * been redrawn.
+	 */
+	mode = window_pane_mode(wp);
+	if (s == &wp->base || mode == WINDOW_PANE_COPY_MODE) {
+		cm_offset = cm_size = 0;
+		if (mode == WINDOW_PANE_COPY_MODE &&
+		    window_copy_get_current_offset(wp, &cm_offset, &cm_size) == 0)
+			return;
+		TAILQ_FOREACH(oe, &wp->osc66_entries, entry) {
+			row = oe->y + cm_size - cm_offset;
+			if (oe->x >= wp->sx || row >= wp->sy)
+				continue;
+			if (wp->xoff + oe->x < ctx->ox ||
+			    wp->xoff + oe->x >= ctx->ox + ctx->sx ||
+			    wp->yoff + row < ctx->oy ||
+			    wp->yoff + row >= ctx->oy + ctx->sy)
+				continue;
+			x = wp->xoff + oe->x - ctx->ox;
+			y = top + wp->yoff + row - ctx->oy;
+			tty_region_off(tty);
+			tty_margin_off(tty);
+			tty_cursor(tty, x, y);
+			tty_puts(tty, oe->data);
+			tty_invalidate(tty);
+		}
+	}
